{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "characteristic": {
      "oneOf": [
        {
          "type": "number",
          "min": 0,
          "max": 100
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "min": 0,
              "max": 100
            },
            "unnatural": {
              "type": "number",
              "min": 2
            },
            "bonus": {
              "type": "number",
              "min": 1,
              "description": "profile uses this number instead of calculating"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "damageType": {
      "type": "string",
      "enum": ["explosion", "impact", "energy", "rending"]
    },
    "creatureWeapon": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "section": {
                "type": "string",
                "enum": ["melee", "ranged", "relic"]
              }
            }
          },
    "creature": {
      "type": "object",
      "title": "creature",
      "description": "a rendered creature profile",
      "patternProperties": {
        "^type$": {
          "type": "string",
          "description": "the type of creature... or rather the entry. always will be 'creature'",
          "const": "creature"
        }
      },
      "properties": {
        "parentPath": {
          "type": "string",
          "description": "the path to section's supersection. omitted if in group or self is a root section"
        },
        "source": {
          "type": "string",
          "description": "the source id, will default to rootSource if not present"
        },
        "name": {
          "type": "string",
          "description": "the identifier"
        },
        "displayName": {
          "type": "string",
          "description": "the actual displayed name; if empty, will be the same as [name]"
        },
        "tier": {
          "type": "string",
          "description": "the tier of enemy: troop, elite, or master",
          "enum": ["troop", "elite", "master", null]
        },
        "characteristics": {
          "type": "object",
          "description": "characteristic values of the creature",
          "properties": {
            "weaponSkill": {
              "$ref": "#/$defs/characteristic"
            },
            "ballisticSkill": {
              "$ref": "#/$defs/characteristic"
            },
            "strength": {
              "$ref": "#/$defs/characteristic"
            },
            "toughness": {
              "$ref": "#/$defs/characteristic"
            },
            "agility": {
              "$ref": "#/$defs/characteristic"
            },
            "intelligence": {
              "$ref": "#/$defs/characteristic"
            },
            "perception": {
              "$ref": "#/$defs/characteristic"
            },
            "willpower": {
              "$ref": "#/$defs/characteristic"
            },
            "fellowship": {
              "$ref": "#/$defs/characteristic"
            }
          }
        },
        "movement": {
          "type": ["number", "null"],
          "description": "movement bonus for size for half move"
        },
        "wounds": {
          "type": "number",
          "min": 1,
          "description": "the creature's health"
        },
        "skills": {
          "description": "an array of the creature's skills",
          "type": ["array", "null"],
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "rendered literally"
              },
              {
                "type": "object",
                "description": "rendered as a link",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "modifier": {
                    "type": "number",
                    "enum": [null, 10, 20]
                  }
                }
              }
            ]
          }
        },
        "talents": {
          "description": "an array of the creature's talents",
          "type": ["array", "null"],
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "rendered literally"
              },
              {
                "type": "object",
                "description": "rendered as a link",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        },
        "traits": {
          "description": "an array of the creature's traits",
          "type": ["array", "null"],
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "rendered literally"
              },
              {
                "type": "object",
                "description": "rendered as a link",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "value": {
                    
                  },
                  "horde": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            ]
          }
        },
        "armour": {
          "type": ["object", "null"],
          "description": "the protection the armour provides",
          "properties": {
            "general": {
              "type": "number",
              "description": "the protection on all locations that are not further specified"
            },
            "head": {
              "type": "number",
              "description": "the head protection"
            },
            "body": {
              "type": "number",
              "description": "the body protection"
            },
            "arms": {
              "type": "number",
              "description": "the protection on left and right arms"
            },
            "legs": {
              "type": "number",
              "description": "the protection on left and right legs"
            },
            "leftArm": {
              "type": "number",
              "description": "the left arm protection"
            },
            "rightArm": {
              "type": "number",
              "description": "the right arm protection"
            },
            "leftLeg": {
              "type": "number",
              "description": "the left leg protection"
            },
            "rightLeg": {
              "type": "number",
              "description": "the right leg protection"
            },
            "horde": {
              "type": "number",
              "description": "the protection for a horde"
            },
            "description": {
              "type": "string",
              "description": "the type of armour, eg. flak armour"
            }
          },
          "required": ["description"]
        },
        "weapons": {
          "description": "an array of the creature's weaponry",
          "type": ["array", "null"],
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/creatureWeapon"
              },
              {
                "type": "array",
                "description": "weapon options",
                "items": {
                  "$ref": "#/$defs/creatureWeapon"
                }
              }
            ]
          }
        },
        "gear": {
          "description": "any items the creature is carrying",
          "type": ["array", "null"],
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "rendered literally"
              },
              {
                "type": "object",
                "description": "rendered as a link",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "section": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "content": {
          "description": "the description of the creature",
          "type": "array",
          "items": {
            "$ref": "#/$defs/descItem"
          }
        },
        "rules": {
          "description": "any special rules that apply to the creature",
          "type": "array",
          "items": {
            "$ref": "#/$defs/descItem"
          }
        }
      },
      "required": ["name", "type"]
    },
    "vehicle": {
      "type": "object",
      "title": "vehicle",
      "description": "a vehicle profile",
      "patternProperties": {
        "^type$": {
          "type": "string",
          "const": "vehicle",
          "description": "entry type. always vehicle"
        }
      },
      "properties": {
        "name": {
          "type": "string",
          "description": "the identifier"
        },
        "displayName": {
          "type": "string",
          "description": "the displayed name"
        },
        "vehicleType": {
          "type": "string",
          "enum": ["ground", "walker", "skimmer", "flyer", "spacecraft"]
        },
        "tacticalSpeed": {
          "type": "number",
          "min": 0,
          "description": "in metres"
        },
        "tacticalSpeedAir": {
          "type": "number",
          "min": 0,
          "description": "in AUs"
        },
        "cruisingSpeed": {
          "type": "number",
          "min": 0,
          "description": "in kph"
        },
        "manoeuvrability": {
          "type": ["number", "null"]
        },
        "integrity": {
          "type": "number",
          "min": 1
        },
        "armour": {
          "type": "object",
          "properties": {
            "front": {
              "type": "number",
              "min": 0
            },
            "sides": {
              "type": "number",
              "min": 0
            },
            "back": {
              "type": "number",
              "min": 0
            },
            "all": {
              "type": "number",
              "min": 0
            }
          }
        },
        "size": {
          "type": "string",
          "enum": [
            "minuscule",
            "puny",
            "scrawny",
            "average",
            "hulking",
            "enormous",
            "massive",
            "immense",
            "monumental",
            "titanic"
          ]
        },
        "crew": {
          "type": ["string", "null"]
        },
        "renown": {
          "type": "number",
          "min": 0,
          "max": 4
        },
        "weapons": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "title": "vehicle weapon slot",
                "type": "object",
                "properties": {
                  "facing": {
                    "oneOf": [
                      {
                        "type": "string",
                        "const": "all"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["front", "right", "back", "left", "sides", "down"]
                        }
                      }
                    ]
                  },
                  "operator": {
                    "type": "string"
                  },
                  "mounting": {
                    "type": "string"
                  },
                  "number": {
                    "type": "number"
                  },
                  "info": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "title": "vehicle weapon option",
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "clip": {
                              "type": "number"
                            },
                            "twinLinked": {
                              "type": "boolean"
                            },
                            "info": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "section": {
                              "type": "string"
                            },
                            "source": {
                              "type": "string"
                            },
                            "doublesStrengthBonus": {
                              "type": "boolean"
                            }
                          }
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "capacity": {
          "type": ["string", "null"]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descItem"
          }
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descItem"
          }
        },
        "parentPath": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "characteristics": {
          "type": "object",
          "description": "characteristic values of the vehicle. -1 is operator's value",
          "properties": {
            "weaponSkill": {
              "$ref": "#/$defs/characteristic"
            },
            "ballisticSkill": {
              "$ref": "#/$defs/characteristic"
            },
            "strength": {
              "$ref": "#/$defs/characteristic"
            },
            "toughness": {
              "$ref": "#/$defs/characteristic"
            },
            "agility": {
              "$ref": "#/$defs/characteristic"
            },
            "intelligence": {
              "$ref": "#/$defs/characteristic"
            },
            "perception": {
              "$ref": "#/$defs/characteristic"
            },
            "willpower": {
              "$ref": "#/$defs/characteristic"
            },
            "fellowship": {
              "$ref": "#/$defs/characteristic"
            }
          }
        }
      },
      "required": ["name", "displayName", "type"]
    },
    "section": {
      "type": "object",
      "title": "section",
      "description": "a subset of data",
      "properties": {
        "parentPath": {
          "type": "string",
          "description": "the path to section's supersection. omitted if in group or self is a root section"
        },
        "source": {
          "type": "string",
          "description": "the source id, will default to rootSource if not present"
        },
        "name": {
          "type": "string",
          "description": "the identifier"
        },
        "displayName": {
          "type": "string",
          "description": "the actual displayed name; if empty, will be the same as [name]"
        },
        "display": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["none", "all"]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["description", "table", "items"]
              }
            }
          ],
          "description": "how the section will be displayed. set \"none\" in a subsection"
        },
        "noGrid": {
          "type": "boolean",
          "description": "override default grid display"
        },
        "table": {
          "type": "object",
          "description": "if the display property is 'table' or 'both' defines the table structure as an object with k-v pairs like \"jsonKey\": \"displayName\""
        },
        "content": {
          "type": "array",
          "description": "the text content as an array",
          "items": {
            "$ref": "#/$defs/descItem"
          },
          "unevaluatedProperties": false
        },
        "footnotes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "description": "an array of footnotes that will be used in the section's table"
        }
      },
      "patternProperties": {
        "^type$": {
          "type": "string",
          "const": "section"
        }
      },
      "required": ["type", "name", "display"]
    },
    "item": {
      "type": "object",
      "title": "item",
      "description": "a piece of data",
      "properties": {
        "parentPath": {
          "type": "string",
          "description": "the path to item's section. omitted if in group"
        },
        "name": {
          "type": "string",
          "description": "the identifier"
        },
        "source": {
          "type": "string",
          "description": "the source id, will default to section source if not present"
        },
        "displayName": {
          "type": "string",
          "description": "the actual name displayed"
        },
        "subName": {
          "type": "string",
          "description": "an additional part of the name only shown in descriptions (in parentheses)"
        },
        "shortDesc": {
          "type": "string"
        },
        "prerequsite": {
          "type": "string"
        },
        "footnotes": {
          "type": "object",
          "description": "an object of shape key name: footnote number (footnotes defined in root section)"
        },
        "image": {
          "type": "string"
        },
        "alias": {
          "type": "array",
          "description": "alternative names for the same item",
          "items": {
            "type": "object",
            "description": "an alias",
            "properties": {
              "name": {
                "type": "string",
                "description": "the name that will be used by the parser"
              },
              "displayName": {
                "type": "string",
                "description": "the name visible to the user"
              }
            }
          }
        },
        "content": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/descItem"
              }
            },
            {
              "type": "string"
            }
          ],
          "description": "the text content of the element"
        },
        "class": {
          "type": ["string", "null"],
          "enum": [
            "basic",
            "pistol",
            "heavy",
            "thrown",
            "melee",
            "mounted",
            "placed",
            null
          ],
          "description": "the class of an item. used with weapons"
        },
        "range": {
          "type": ["number", "string", "null"]
        },
        "rof": {
          "type": "object",
          "description": "rate of fire. will be displayed as S/b/a",
          "properties": {
            "single": {
              "type": "boolean",
              "description": "whether the weapon can single fire"
            },
            "burst": {
              "type": ["number", "null"],
              "description": "the burst RoF"
            },
            "auto": {
              "type": ["number", "null"],
              "description": "the auto RoF"
            }
          }
        },
        "damage": {
          "anyOf": [
            {
              "type": "object",
              "description": "the weapon's damage",
              "properties": {
                "formula": {
                  "type": "string",
                  "description": "the dice string to roll for damage",
                  "pattern": "^(?:[\\+-]?(?:\\d*[kd]\\d+(?:[kd][hl]\\d+)?|\\d+))+$"
                },
                "display": {
                  "type": "string",
                  "description": "the dice string that will be displayed",
                  "pattern": "^(?:[\\+-]?(?:\\d*[kd]\\d+(?:[kd][hl]\\d+)?|\\d+))+$"
                }
              },
              "patternProperties": {
                "^type$": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/damageType"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/damageType"
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "penetration": {
          "type": ["number", "string"],
          "description": "the weapon's penetration"
        },
        "parryModifier": {
          "type": "number"
        },
        "hitModifier": {
          "type": "number"
        },
        "clip": {
          "type": ["number", "string", "null"],
          "description": "the weapon's clip size"
        },
        "reload": {
          "type": ["string", "number", "null"],
          "description": "how many actions the weapon takes to reload"
        },
        "qualities": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "description": "the array of qualities",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "the quality name"
                      },
                      "value": {
                        "type": ["number", "string"],
                        "description": "the value that will be displayed in paretheses, eg. Blast (2)"
                      },
                      "footnote": {
                        "type": "number",
                        "description": "the footnote identifier"
                      },
                      "display": {
                        "type": "string",
                        "description": "how the quality will be displayed"
                      },
                      "noParser": {
                        "value": true,
                        "description": "indicates that the quality name will be displayed as static text, not a link"
                      },
                      "source": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        "weight": {
          "type": ["number", "string"],
          "description": "the weight"
        },
        "requisition": {
          "type": ["number", "string", "null"],
          "description": "how much the item costs to requisition"
        },
        "renown": {
          "type": ["number", "null", "string"],
          "description": "the renown level required"
        },
        "armour": {
          "description": "the protection the armour provides",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "general": {
                  "type": "number",
                  "description": "the protection on all locations that are not further specified"
                },
                "head": {
                  "type": ["number", "null"],
                  "description": "the head protection"
                },
                "body": {
                  "type": "number",
                  "description": "the body protection"
                },
                "arms": {
                  "type": "number",
                  "description": "the protection on left and right arms"
                },
                "legs": {
                  "type": "number",
                  "description": "the protection on left and right legs"
                },
                "leftArm": {
                  "type": "number",
                  "description": "the left arm protection"
                },
                "rightArm": {
                  "type": "number",
                  "description": "the right arm protection"
                },
                "leftLeg": {
                  "type": "number",
                  "description": "the left leg protection"
                },
                "rightLeg": {
                  "type": "number",
                  "description": "the right leg protection"
                }
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "protectionRating": {
          "type": "number",
          "description": "the protection rating of a force field. will be parsed as the target of a d100 roll"
        },
        "overload": {
          "type": ["number", "null"],
          "description": "the overload roll range end. will be parsed as the target of a d100 roll. if omitted, 1 will be the target instead"
        },
        "noDesc": {
          "type": "boolean",
          "const": true,
          "description": "whether the item should be omitted in a section's description"
        },
        "noTable": {
          "type": "boolean",
          "const": true,
          "description": "whether the item should be omitted in a section's table"
        },
        "noGrid": {
          "type": "boolean",
          "const": true,
          "description": "the item will be full-width"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "groups": {
          "type": "object",
          "description": "default set of groups. used with talents and skills. object of shape name: display"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "a list of tags indicating special fuctions of the item to the chracter sheet system"
        }
      },
      "patternProperties": {
        "^type$": {
          "not": {
            "anyOf": [
              {
                "type": "string",
                "const": "section"
              },
              {
                "type": "string",
                "const": "group"
              }
            ]
          }
        }
      }
    },
    "rollTable": {
      "title": "rollable table",
      "type": "object",
      "description": "just a table",
      "properties": {
        "name": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "table": {
          "type": "object"
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "an item in a rollable table",
            "properties": {
              "match": {
                "type": "number",
                "minimum": 1,
                "maximum": 100,
                "description": "used if the item corresponds to exactly one roll result"
              },
              "range": {
                "type": "object",
                "description": "the range of the roll that will result in the item being chosen",
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100,
                    "description": "the range start. if not found, will be assumed as 1"
                  },
                  "max": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100,
                    "description": "the range end. if not found, will be assumed as 100"
                  }
                }
              }
            }
          }
        },
        "index": {
          "type": "object",
          "properties": {
            "chapter": {
              "type": "number"
            },
            "number": {
              "type": "number"
            }
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "number"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "rollable": {
          "type": "boolean",
          "const": true
        }
      },
      "patternProperties": {
        "^type$": {
          "type": "string",
          "const": "table"
        }
      },
      "required": ["type", "name", "content", "table", "rollable"],
      "unevaluatedProperties": false
    },
    "table": {
      "title": "table",
      "type": "object",
      "description": "just a table",
      "properties": {
        "name": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "table": {
          "type": "object"
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "index": {
          "type": "object",
          "properties": {
            "chapter": {
              "type": "number"
            },
            "number": {
              "type": "number"
            }
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "number"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      },
      "patternProperties": {
        "^type$": {
          "type": "string",
          "const": "table"
        }
      },
      "required": ["type", "name", "content", "table"],
      "unevaluatedProperties": false
    },
    "descItem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "title": "list",
          "description": "represents a collection of paragraphs that form an enumeration",
          "properties": {
            "title": {
              "type": "string",
              "description": "list title"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/descItem"
              },
              "description": "list content"
            },
            "style": {
              "type": "string",
              "enum": ["unordered", "ordered"],
              "description": "list style: unordered or ordered"
            }
          },
          "patternProperties": {
            "^type$": {
              "type": "string",
              "const": "list"
            }
          },
          "required": ["type", "style", "content"]
        },
        {
          "type": "object",
          "title": "example",
          "description": "example. can also be done with an %example inserting tag, but allows for inserting other elements into the example and multi-paragraph examples",
          "properties": {
            "content": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/descItem"
                  }
                }
              ],
              "description": "example content, equivalent to content enclosed in curly braces in an %example inserting tag"
            }
          },
          "patternProperties": {
            "^type$": {
              "type": "string",
              "const": "example",
              "description": "the type of example. is example and never will be anything else"
            }
          },
          "required": ["type", "content"]
        },
        {
          "type": "object",
          "title": "textTable",
          "description": "a table that is not parsed, contains straight text",
          "properties": {
            "header": {
              "description": "an array of header cells",
              "type": "array",
              "items": {
                "type": "string",
                "description": "a header cell"
              }
            },
            "rows": {
              "description": "an array of rows",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "a singular cells"
                },
                "description": "a row, an array of cells"
              }
            }
          },
          "patternProperties": {
            "^type$": {
              "type": "string",
              "const": "textTable",
              "description": "the type of element. is and always will be textTable"
            }
          },
          "required": ["type", "header", "rows"]
        },
        {
          "type": "object",
          "title": "text element",
          "properties": {
            "title": {
              "type": "string",
              "description": "the title that will be displayed in bold"
            },
            "content": {
              "description": "the actual content",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/descItem"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descItem"
          }
        }
      ]
    },
    "group": {
      "title": "group",
      "type": "object",
      "description": "a construct that groups sections or items with the same parent",
      "properties": {
        "parentPath": {
          "type": "string",
          "pattern": "^[a-zA-Z]+(?:\\|[a-zA-Z]+)?(?:-[a-zA-Z]+(?:\\|[a-zA-Z]+)?)*$",
          "description": "the tree of parent sections separated with '-' signs"
        },
        "source": {
          "type": "string",
          "description": "a source to be shared by all contained items"
        }
      },
      "patternProperties": {
        "^items$": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/rollTable"
              },
              {
                "$ref": "#/$defs/table"
              },
              {
                "$ref": "#/$defs/vehicle"
              },
              {
                "$ref": "#/$defs/creature"
              },
              {
                "$ref": "#/$defs/section"
              },
              {
                "$ref": "#/$defs/item"
              }
            ]
          }
        },
        "^type$": {
          "type": "string",
          "const": "group"
        }
      },
      "additionalProperties": false,
      "required": ["items", "type"]
    },
    "source": {
      "type": "object",
      "title": "source",
      "description": "a collection of data, such as one book",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "the name that will be displayed"
        },
        "name": {
          "type": "string",
          "description": "a RPC source's identifier"
        },
        "brewed": {
          "type": "boolean",
          "description": "whether the source is official content or homebrew"
        },
        "author": {
          "type": "string",
          "description": "author of the source material"
        },
        "transcriber": {
          "type": "string",
          "description": "the one who wrote the source file. empty implies the same as author"
        },
        "core": {
          "type": "boolean",
          "description": "core sources are always displayed",
          "const": true
        },
        "index": {
          "type": "number"
        },
        "color": {
          "type": "string",
          "description": "all mentions of this source will be the [name] colored thusly. can be any color accepted in CSS or a tailwind color",
          "oneOf": [
            {
              "pattern": "^#([0-9a-f]{3}){1,2}$"
            },
            {
              "pattern": "^#([0-9a-f]{4}){1,2}$"
            },
            {
              "pattern": "rgb\\((\\d+,){2}\\d+\\)"
            },
            {
              "pattern": "rgba\\((\\d+,){3}\\(0\\.\\)?\\d+\\)"
            },
            {
              "pattern": "cmyk\\((\\d+,){3}\\d+\\)"
            },
            {
              "pattern": "[a-z]+-\\d+\\(!\\d+\\)?"
            },
            {
              "pattern": "[a-z]+"
            }
          ]
        }
      }
    },
    "head": {
      "type": "object",
      "title": "head",
      "description": "the information that does not constitute actual data",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "description": "a collection of source definitions"
        },
        "author": {
          "type": "string",
          "description": "the autor of the document"
        },
        "version": {
          "type": ["number", "string"],
          "description": "version id of shape [number] or [version string]"
        },
        "rootSource": {
          "type": "string",
          "description": "a default source to use"
        }
      }
    }
  },
  "type": "object",
  "required": ["head", "content"],
  "properties": {
    "head": {
      "$ref": "#/$defs/head"
    },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/rollTable"
          },
          {
            "$ref": "#/$defs/table"
          },
          {
            "$ref": "#/$defs/item"
          },
          {
            "$ref": "#/$defs/vehicle"
          },
          {
            "$ref": "#/$defs/creature"
          },
          {
            "$ref": "#/$defs/group"
          },
          {
            "$ref": "#/$defs/section"
          }
        ]
      }
    }
  }
}
